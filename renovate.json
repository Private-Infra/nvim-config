{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["NVIM_VERSION: \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "neovim/neovim",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Même version que les postes (astro_nvim_neovim_version d'ansible-home, suivie aussi par Renovate) ; fusion après la CI verte.",
      "matchPackageNames": ["neovim/neovim"],
      "groupName": "neovim"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "automerge": true
    }
  ],
  "platformAutomerge": false
}
